# ==========================================
# JobsAPI Integration Monorepo .gitignore
# ==========================================

# 1. Environment & Secret Files (Never commit credentials)
.env
.env.local
.env.*.local
*.local
!*.example

# 2. Dependencies
node_modules/
.pnp
.pnp.js
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# 3. Production Builds & Bundles
dist/
dist-ssr/
build/
out/
.next/

# 4. Logs & Diagnostic Dumps
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
combined.log
error.log

# 5. Playwright & Test Artifacts
test-results/
playwright-report/
.playwright/
.pytest_cache/
coverage/
.nyc_output/
.coverage
htmlcov/

# 6. Browser & Automation Profile Data
data/browser_profiles/
data/browser_profile/
dice-automation-backend/data/
dice-automation-backend/resumes/*
!dice-automation-backend/resumes/.gitkeep
!dice-automation-backend/sample_resumes/

# 7. OS & IDE Specific
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
