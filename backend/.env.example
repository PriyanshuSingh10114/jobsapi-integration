# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/jobsapi
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# Redis & Queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=dev_insecure_jwt_secret_change_in_prod
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=dev_admin_api_key_12345
DEFAULT_USER_ID=local_admin_1

# ATS Integrations
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_USER_AGENT=your_email@domain.com
SYNC_INTERVAL_HOURS=6
JOB_RETENTION_DAYS=30
MAX_CONCURRENT_REQUESTS=10
STRICT_US_MODE=true

# Automation & Playwright
BROWSER_POOL_SIZE=5
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PAGE_TIMEOUT_MS=30000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=45000
AUTOMATION_CONCURRENCY=3

# Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Observability
LOG_LEVEL=debug
ENABLE_FILE_LOGGING=true
ENABLE_TELEMETRY=true
