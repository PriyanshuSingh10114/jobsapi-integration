# =============================================================================
# JobsAPI Integration Platform - Unified Monorepo Environment Template
# Copy this file to individual application .env files or use with Docker Compose
# =============================================================================

# -----------------------------------------------------------------------------
# 1. JobsAPI Backend Configuration (`backend/.env`)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB) & Caching (Redis)
MONGODB_URI=mongodb://localhost:27017/jobsapi
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=dev_insecure_jwt_secret_change_in_prod
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=dev_admin_api_key_12345
DEFAULT_USER_ID=local_admin_1

# ATS Ingestion Configuration
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_USER_AGENT=support@jobsapi.local
SYNC_INTERVAL_HOURS=6
JOB_RETENTION_DAYS=30
MAX_CONCURRENT_REQUESTS=10
STRICT_US_MODE=true

# Automation & Playwright Worker
BROWSER_POOL_SIZE=5
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PAGE_TIMEOUT_MS=30000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=45000
AUTOMATION_CONCURRENCY=3

# Storage & Telemetry
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
LOG_LEVEL=debug
ENABLE_FILE_LOGGING=true
ENABLE_TELEMETRY=true

# Dice Ingestion & RPA Controls (Consolidated Native Backend)
DICE_BROWSER_MODE=local
DICE_HEADLESS=true
DICE_BROWSER_DATA_DIR=./data/browser_profiles

# -----------------------------------------------------------------------------
# 2. Consolidated Frontend Configuration (`frontend/.env`)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_DICE_API_BASE_URL=http://localhost:5000/api/dice

